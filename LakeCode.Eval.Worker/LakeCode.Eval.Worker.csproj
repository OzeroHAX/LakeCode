<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LakeCode.Eval.Contracts/LakeCode.Eval.Contracts.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
  </ItemGroup>
  <Target Name="GetEvalWorkerFiles" Returns="@(EvalWorkerOutputFiles)">
    <Error Condition="'$(TargetDir)' == ''" Text="C# worker output directory was not resolved." />
    <ItemGroup>
      <EvalWorkerOutputFiles Include="$(TargetDir)**/*" Exclude="$(TargetDir)publish/**/*" />
    </ItemGroup>
  </Target>
</Project>
